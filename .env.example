# ---------------------------------------------------------------------------
# Nahhas Field Engineer Portal — environment
#
# Copy this file to `.env` and set VITE_API_BASE for the environment you are
# pointing at. Only ONE variable is needed. Vite only exposes vars prefixed
# with VITE_ to the browser, and the value is baked in at BUILD time — so a
# production build must be made with the production value present.
# ---------------------------------------------------------------------------

# LOCAL DEVELOPMENT (default — talk to a local Odoo instance).
# Match the port your local Odoo actually listens on (8069 is the Odoo
# default; use 8019 if that is how your instance is configured).
# The Vite dev server runs on :5173, so these calls are cross-origin. The
# API's default `Access-Control-Allow-Origin: *` covers this — no proxy needed.
VITE_API_BASE=http://localhost:8069/api/field_portal/v1

# PRODUCTION — app served from https://site.nahas.group, API on erp.nahas.group.
# Different origins, so CORS still applies. Before going live, lock the API's
# Access-Control-Allow-Origin down from `*` to `https://site.nahas.group`.
# VITE_API_BASE=https://erp.nahas.group/api/field_portal/v1
